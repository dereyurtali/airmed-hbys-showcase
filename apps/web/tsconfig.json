{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    // Web typecheck'i transitive olarak api'nin AppRouter type'ını alıyor;
    // api'nin NestJS decorator'ları (@Cron, @Injectable, vb.) legacy TS
    // decorator semantik'i bekliyor. experimentalDecorators web tsconfig'ine
    // de eklendi ki web tsc bu dosyalardaki @Cron'u doğru parse etsin.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
