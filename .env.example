# ==============================================================================
# AirMed-HBYS v0.2 — Environment Variables Template
# Copy this file to .env and fill in actual values. Never commit .env.
# ==============================================================================

# --- Database ---
# Admin role — used by Prisma migrations and seed (owner of schema).
DATABASE_URL=postgresql://airmed:airmed_dev@localhost:5432/airmed_hbys?schema=public
# Runtime role — non-superuser, NOBYPASSRLS so Postgres RLS policies actually apply.
# Created in docker/postgres/init.sh; falls back to DATABASE_URL when unset.
# #969 — connection_limit EXPLICIT (implicit cpu*2+1 yerine). Her authenticated
# istek RLS için bir interactive tx = bir bağlantı tutar → eşzamanlılık tavanı =
# havuz boyutu. Donanıma göre ayarla (Mac Mini için ölç); Postgres max_connections
# (default 100) ile admin/bg havuzlarını da hesaba kat.
DATABASE_URL_APP=postgresql://airmed_app:airmed_app_dev@localhost:5432/airmed_hbys?schema=public&connection_limit=20
# Background/cross-tenant role — NOSUPERUSER BYPASSRLS (#916). Used by sync,
# audit-cleanup, messaging, platform admin, fraud, auth-lookup, setup clients so
# they don't run as the postgres superuser. Created in docker/postgres/init.sh;
# falls back to DATABASE_URL when unset.
DATABASE_URL_BG=postgresql://airmed_bg:airmed_bg_dev@localhost:5432/airmed_hbys?schema=public
# Per-request RLS transaction süre sınırları (ms). Boş bırakılırsa Prisma default'u
# (5000 / 2000) kullanılır. Yavaş raporlama node'unda timeout'u yükseltebilirsin;
# ama yüksek değer bağlantı havuzunu daha uzun tutar — dikkatli ayarla.
# PRISMA_TX_TIMEOUT_MS=5000
# PRISMA_TX_MAX_WAIT_MS=2000

# --- Server ---
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_me_with_random_32_byte_base64
JWT_REFRESH_SECRET=replace_me_with_different_random_32_byte_base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# #921 — inaktivite (idle) oturum timeout'u (dakika). Refresh token bu süreden
# uzun kullanılmazsa idle-expired → yeniden giriş. Klinik + platform ortak eşik.
SESSION_IDLE_TIMEOUT_MINUTES=30
BCRYPT_COST=12

# --- Platform Admin Auth (F2 — DNA Software Solutions internal) ---
# DISTINCT secrets from JWT_*. Same machine but admin.dnasoft.co only.
PLATFORM_JWT_ACCESS_SECRET=replace_me_with_distinct_32_byte_base64
PLATFORM_JWT_REFRESH_SECRET=replace_me_with_different_32_byte_base64

# F4 — Impersonation token: platform admin başka kullanıcı kimliği üstlendiğinde
# kullanılan tenant-side JWT'nin imza secret'i. Klinik JWT_ACCESS_SECRET'inden
# AYRI olmak ZORUNDA — aksi halde klinik secret leak iki yetki sınırını birden
# devirir (denetim P0 2.3). Generate with: openssl rand -base64 32
PLATFORM_IMPERSONATION_JWT_SECRET=replace_me_with_yet_another_distinct_32_byte_base64
PLATFORM_JWT_ACCESS_TTL=15m
PLATFORM_JWT_REFRESH_TTL=7d
PLATFORM_BCRYPT_COST=12
PLATFORM_TOTP_ISSUER=AirMed-HBYS Platform
# #914 — platform admin 2FA (TOTP) secret'larını DB'de AES-256-GCM ile şifreler.
# 64-hex (32 byte) tercih edilir; değilse sha256 türetilir. PROD'da ZORUNLU
# (eksikse TotpService boot'ta throw eder). Üret: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32
# Dev escape hatch — seeds 0.0.0.0/0 in IP allowlist so localhost works.
# MUST be unset (or false) in production deployments.
DEV_PLATFORM_OPEN_IPS=true

# --- Seed (development + CI) ---
SEED_ADMIN_PASSWORD=admin123
SEED_E2E_PASSWORD=e2e-test-pass
SEED_PLATFORM_OWNER_PASSWORD=platform-owner-dev-pass

# --- CORS ---
WEB_ORIGIN=http://localhost:5173

# --- Hybrid Sync (lokal ↔ bulut) ---
SYNC_MODE=local
# SYNC_MODE=cloud
SYNC_PEER_URL=
SYNC_PEER_TOKEN=

# --- Storage (file uploads) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3-compatible alternative
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Feedback → GitHub issue (I2.3 #821; prod-only — yoksa issue açma atlanır) ---
GITHUB_TOKEN=
GITHUB_FEEDBACK_REPO=

# --- Messaging (post-op, hatırlatmalar) ---
MESSAGING_PROVIDER=none
# MESSAGING_PROVIDER=whatsapp_business
# MESSAGING_PROVIDER=twilio
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Monitoring ---
# Backend hata izleme (apps/api). Boşsa Sentry dormant kalır (hiçbir şey gönderilmez).
SENTRY_DSN=
# Frontend hata izleme (apps/web — Vite ile build-time inject; VITE_ prefix zorunlu).
VITE_SENTRY_DSN=
# Deploy edilen git SHA — GlitchTip release etiketi (deploy.sh / compose inject eder).
APP_RELEASE=
# Açık ortam etiketi: staging + prod ikisi de NODE_ENV=production koşar; iki ayrı
# GlitchTip örneğini (prod→klinik / staging→staging-box) ayırmak için set edilir.
SENTRY_ENVIRONMENT=
# FE ortam etiketi override (staging/prod ayrımı; boşsa Vite MODE'a düşer).
VITE_SENTRY_ENVIRONMENT=
# FE source map yükleme (apps/web build). Token boşsa plugin dormant: map üretilmez,
# bundle'a sızmaz. GlitchTip kurulunca (I1.4) deploy bunları set eder.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
LOG_LEVEL=info

# --- Redis (queue/cache, optional) ---
REDIS_URL=redis://localhost:6379

# #428 — Hasta hatırlatma SMS kanalı (no-show azaltma). Set edilirse D1 messaging
# SMS provider'ı aktifleşir (randevu hatırlatma / "gelmeden öde" / ameliyat günü
# talimatları). Boşsa MOCK kanal kullanılır (gerçek SMS gitmez).
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SMS_GATEWAY_FROM=

# EPIC #1018 — AI Hasta Asistanı (Chatwoot + LLM). Boşsa otomasyon pasif:
# webhook 503 döner (fail-safe), agent cevap üretemez.
# Chatwoot: Settings→Bots'tan alınan bot access token + hesap base URL'i.
AUTOMATION_WEBHOOK_SECRET=
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_BOT_TOKEN=
# Model sağlayıcı anahtarları (AgentConfig.provider hangisiyse o gerekir).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
